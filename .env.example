# Copy to .env and adjust; never commit .env, no secrets here

# ACS namespace and secured cluster name
ACS_NS=stackrox
ACS_CLUSTER=demo-cluster

# Quay namespace
QUAY_NS=quay

# Gitea namespace, the demo's Git server
GITEA_NS=gitea

# our Keycloak namespace, separate from any other Keycloak on the cluster
KC_NS=demo-keycloak

# base image watched by base-watch, and the baseline digest prod starts on
BASE_REPO=registry.access.redhat.com/hi/python
BASE_STREAM=3.11
BASELINE_DIGEST=sha256:7a5952bcecbf15995fd6ef6605e8cf9f9f82949a09b0142db768b64d6f610a0d

# AI approval briefing, future work
LITEMAAS_URL=https://maas-rhdp.apps.maas.redhatworkshops.io/v1
LITEMAAS_MODEL=llama-scout-17b
